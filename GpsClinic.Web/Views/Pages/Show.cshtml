@model Page
@inject GpsClinic.Web.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.MetaDescription;
    var settings = await Db.SiteSettings.ToDictionaryAsync(s => s.Key, s => s.Value);
    string S(string key, string fallback = "") => settings.TryGetValue(key, out var v) ? v : fallback;
}

<section class="page-hero" style="background:var(--navy);padding:80px 0 60px;">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="bc-sep">›</span><span>@Model.Title</span></nav>
    <h1 style="color:var(--white);margin-top:16px;">@Model.Title</h1>
    @if (!string.IsNullOrEmpty(Model.Subtitle))
    {
      <p style="color:var(--muted);font-size:1.05rem;max-width:600px;margin-top:12px;">@Model.Subtitle</p>
    }
  </div>
</section>

<section class="section" style="padding:72px 0;">
  <div class="container" style="max-width:800px;">
    @if (Model.Slug == "about-us")
    {
      <div class="post-content">@Html.Raw(Model.ContentHtml)</div>

      <div style="margin-top:56px;">
        <div style="text-align:center;margin-bottom:32px;">
          <span class="section-eyebrow">@S(SiteSettingKeys.AboutBrandsEyebrow, "Hardware Partners")</span>
          <h2>@S(SiteSettingKeys.AboutBrandsHeading, "Trusted Brands We Supply")</h2>
        </div>
        <div class="brand-grid">
          @foreach (var (name, file) in new[] { ("Concox","concox.svg"), ("Queclink","queclink.svg"), ("Teltonika","teltonika.svg"), ("Coban","coban.svg"), ("Jimi IoT","jimi-iot.svg"), ("Suntech","suntech.svg") })
          {
            <div class="brand-card"><img src="/images/brands/@file" alt="@name logo" width="140" height="48" loading="lazy"></div>
          }
        </div>
        <p style="text-align:center;color:var(--muted);font-size:.85rem;margin-top:24px;">@S(SiteSettingKeys.AboutBrandsDisclaimer, "Brand names are used for identification only. GPS Clinic is an independent reseller and integrator.")</p>
      </div>
    }
    else
    {
      <div class="post-content">@Html.Raw(Model.ContentHtml)</div>
    }
  </div>
</section>

@await Html.PartialAsync("_CtaBand", (S(SiteSettingKeys.CtaPagesTitle, "Ready to Get Started?"), S(SiteSettingKeys.CtaPagesSubtitle, "Get a free site visit, device demo, or same-day quotation from our local team."), (string?)null))
