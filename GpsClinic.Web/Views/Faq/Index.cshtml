@model List<FaqCategory>
@inject GpsClinic.Web.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = "Frequently Asked Questions";
    var settings = await Db.SiteSettings.ToDictionaryAsync(s => s.Key, s => s.Value);
    string S(string key, string fallback = "") => settings.TryGetValue(key, out var v) ? v : fallback;
    var whatsapp = S(SiteSettingKeys.ContactWhatsApp, "919260202020");
}

<section class="page-hero" style="background:var(--navy);padding:80px 0 60px;">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="bc-sep">›</span><span>FAQ</span></nav>
    <h1 style="color:var(--white);margin-top:16px;">@S(SiteSettingKeys.PageFaqHeading, "Frequently Asked Questions")</h1>
    <p style="color:var(--muted);font-size:1.1rem;max-width:540px;margin-top:12px;">@S(SiteSettingKeys.PageFaqIntro, "Everything you need to know about GPS tracking hardware, software, installation, and pricing.")</p>
  </div>
</section>

<section class="section" style="padding:72px 0;">
  <div class="container" style="max-width:800px;">
    @foreach (var cat in Model)
    {
      <div style="margin-bottom:48px;">
        <h2 style="font-size:1.3rem;border-bottom:2px solid var(--border);padding-bottom:12px;margin-bottom:24px;">@cat.Name</h2>
        <div class="faq-list">
          @foreach (var faq in cat.Items)
          {
            <div class="faq-item">
              <button class="faq-question" aria-expanded="false">
                @faq.Question
                <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="faq-answer"><p>@faq.Answer</p></div>
            </div>
          }
        </div>
      </div>
    }

    <div style="background:var(--bg);border-radius:16px;padding:40px;text-align:center;margin-top:48px;">
      <h3>@S(SiteSettingKeys.FaqStillHeading, "Still have a question?")</h3>
      <p style="color:var(--mid);margin:12px 0 24px;">@S(SiteSettingKeys.FaqStillText, "Our team is happy to answer specific queries about your fleet size, vehicle types, or budget.")</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/contact" class="btn btn-primary">@S(SiteSettingKeys.FaqStillContactLabel, "Contact Us")</a>
        <a href="https://wa.me/@whatsapp" class="btn" style="background:var(--green);color:var(--white);">@S(SiteSettingKeys.FaqStillWhatsAppLabel, "WhatsApp")</a>
      </div>
    </div>
  </div>
</section>

@await Html.PartialAsync("_CtaBand", (S(SiteSettingKeys.CtaFaqTitle, "Still Have Questions?"), S(SiteSettingKeys.CtaFaqSubtitle, "Our team is on-call. WhatsApp us, call, or drop a message - we reply within 4 hours."), S(SiteSettingKeys.CtaFaqButton, "Send Us a Message")))
