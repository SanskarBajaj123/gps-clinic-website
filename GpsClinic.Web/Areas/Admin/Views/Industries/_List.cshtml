@model List<Industry>
<div class="a-page-head">
  <h2>Industries</h2>
  <a href="/admin/industries/create" hx-get="/admin/industries/create" hx-target="#admin-main" hx-push-url="true" class="a-btn a-btn--primary">+ Add Industry</a>
</div>

@if (Model.Any())
{
  <table class="a-table">
    <thead><tr><th>Name</th><th>Tagline</th><th>Home?</th><th>Order</th><th></th></tr></thead>
    <tbody>
      @foreach (var ind in Model)
      {
        <tr>
          <td><strong>@ind.Name</strong></td>
          <td>@ind.Tagline</td>
          <td><span class="a-badge @(ind.ShowOnHome ? "a-badge--on" : "a-badge--off")">@(ind.ShowOnHome ? "On homepage" : "—")</span></td>
          <td>@ind.SortOrder</td>
          <td class="a-actions">
            <a href="/admin/industries/@ind.Id/edit" hx-get="/admin/industries/@ind.Id/edit" hx-target="#admin-main" hx-push-url="true" class="a-btn a-btn--ghost a-btn--sm">Edit</a>
            <form hx-post="/admin/industries/@ind.Id/delete" hx-target="#admin-main" hx-confirm="Delete '@ind.Name'?">
              @Html.AntiForgeryToken()
              <button type="submit" class="a-btn a-btn--danger a-btn--sm">Delete</button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
else
{
  <p class="a-empty">No industries yet.</p>
}
