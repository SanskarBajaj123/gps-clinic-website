@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Login - GPS Clinic</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800&family=DM+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
</head>
<body class="admin-body">
  <div class="a-login-wrap">
    <div class="a-login-card">
      <h1>GPS Clinic Admin</h1>
      <p>Sign in to manage hardware, solutions, blog, and site content.</p>
      @if (!ViewData.ModelState.IsValid)
      {
        <div class="a-alert a-alert--error">Invalid email or password.</div>
      }
      <form method="post" action="/admin/login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div class="a-form-row">
          <label for="login-email">Email</label>
          <input type="email" id="login-email" name="email" required autofocus autocomplete="username" placeholder="you@gpsclinic.co.in">
        </div>
        <div class="a-form-row">
          <label for="login-password">Password</label>
          <div class="a-password-field">
            <input type="password" id="login-password" name="password" required autocomplete="current-password" placeholder="Enter your password">
            <button type="button" class="a-password-toggle" id="login-password-toggle" aria-label="Show password" aria-pressed="false">
              <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.94 10.94 0 0112 20c-7 0-11-8-11-8a20.3 20.3 0 015.06-6.06M9.9 4.24A10.4 10.4 0 0112 4c7 0 11 8 11 8a20.4 20.4 0 01-3.22 4.5M14.12 14.12a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>
        <button type="submit" class="a-btn a-btn--primary" style="width:100%;justify-content:center;padding:11px;">Sign In</button>
      </form>
    </div>
  </div>
  <script>
    var pwInput = document.getElementById('login-password');
    var toggle = document.getElementById('login-password-toggle');
    toggle.addEventListener('click', function () {
      var show = pwInput.type === 'password';
      pwInput.type = show ? 'text' : 'password';
      toggle.querySelector('.eye-open').style.display = show ? 'none' : '';
      toggle.querySelector('.eye-closed').style.display = show ? '' : 'none';
      toggle.setAttribute('aria-pressed', show);
      toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
  </script>
</body>
</html>
