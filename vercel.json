{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/wp-admin/(.*)",   "dest": "/wp-admin/$1" },
    { "src": "/wp-includes/(.*)", "dest": "/wp-includes/$1" },
    { "src": "/wp-content/(.*)", "dest": "/wp-content/$1" },
    { "src": "/(.*\\.php)",      "dest": "/$1" },
    { "src": "/(.*)",            "dest": "/index.php" }
  ]
}
